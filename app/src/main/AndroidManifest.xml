<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissões pedidas em runtime na CameraScreen -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Só relevantes até o Android 9. A partir do 10 (API 29) o app escreve pelo
      MediaStore, que não exige permissão para a própria mídia; sem o
      maxSdkVersion, o Google Play trata como acesso amplo a armazenamento e
      exige justificativa. O código já reflete isso: WRITE_EXTERNAL_STORAGE só é
      pedido em runtime quando SDK_INT < Q.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Opcionais: só usadas quando "Salvar localização" está ligado -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      ACCESS_MEDIA_LOCATION foi removida: serve para ler o GPS embutido em mídia
      de terceiros, e este app só escreve o próprio EXIF. Permissão declarada e
      não usada é passivo no formulário de segurança de dados da loja.
    -->

    <!--
      A câmera é obrigatória — sem ela o app não tem função. Já o autofoco não:
      exigi-lo excluía aparelhos da Play Store sem necessidade, porque a captura
      funciona com foco fixo.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".SpaceCameraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpaceCamera">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            android:windowLayoutInDisplayCutoutMode="shortEdges"
            android:theme="@style/Theme.SpaceCamera">

            <!--
              A partir do targetSdk 36 o Android ignora screenOrientation, proporção
              e resizability em telas com largura mínima >= 600dp. Verificado em
              emulador de tablet API 36: sem esta propriedade a activity recebe os
              limites de paisagem cheios (2560x1600) e o layout de retrato se espalha.

              Esta é a fuga oficial, e é temporária: o framework remove o opt-out
              no targetSdk 37. Vale como ponte até a UI adaptativa ficar pronta —
              ver a spec de layout adaptativo em specs/.
            -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
